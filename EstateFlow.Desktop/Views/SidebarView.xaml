<UserControl x:Class="EstateFlow.Desktop.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext: ShellViewModel -->

    <UserControl.Resources>
        <!-- Tag = the screen name; highlighted when it is the current screen. -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Command" Value="{Binding NavigateCommand}"/>
            <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3"
                                BorderThickness="2,0,0,0" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2B2F35"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2B2F35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualsMultiConverter}">
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="CurrentScreen"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                    <Setter Property="Background" Value="#2B2F35"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Width="212" Background="{StaticResource BgPanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="8,16,8,0">
            <TextBlock Text="NAVIGATION" Style="{StaticResource MonoLabelStyle}"
                       FontSize="9" Margin="12,0,0,8"/>

            <Button Content="Dashboard" Tag="dashboard" Style="{StaticResource NavButtonStyle}"/>
            <Button Content="Diary" Tag="diary" Style="{StaticResource NavButtonStyle}"/>
            <Button Content="Documents" Tag="document-scan" Style="{StaticResource NavButtonStyle}"
                    ToolTip="Documents for the estate you opened last"/>
            <Button Content="Reports" Tag="reports" Style="{StaticResource NavButtonStyle}"/>

            <StackPanel Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="FIRM" Style="{StaticResource MonoLabelStyle}"
                           FontSize="9" Margin="12,18,0,8"/>
                <Button Content="Administration" Tag="admin" Style="{StaticResource NavButtonStyle}"
                        ToolTip="Staff accounts, estate assignment, audit log, letter wording"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="12,0,12,12">
            <Border BorderBrush="#33373E" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Top" Margin="0,0,10,0">
                        <TextBlock Text="{Binding UserInitials}" Foreground="{StaticResource TextBrightBrush}"
                                   FontFamily="{StaticResource SansFont}" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding UserDisplayName}" Style="{StaticResource BodyTextStyle}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding UserDisplayName}"/>
                        <TextBlock Text="{Binding UserRoleLabel}" Style="{StaticResource MonoLabelStyle}" FontSize="10" Margin="0,2,0,8"/>

                        <Button Content="Security &amp; 2FA" Command="{Binding NavigateCommand}" CommandParameter="security"
                                HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource SansFont}"
                                FontSize="12" Padding="0,0,0,4" Cursor="Hand"/>

                        <Button Content="Sign out" Command="{Binding LogoutCommand}"
                                HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextDimBrush}" FontFamily="{StaticResource SansFont}"
                                FontSize="12" Padding="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
