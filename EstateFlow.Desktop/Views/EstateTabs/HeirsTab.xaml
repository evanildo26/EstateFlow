<UserControl x:Class="EstateFlow.Desktop.Views.EstateTabs.HeirsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext: EstateDetailViewModel (inherited from EstateDetailView). -->

    <ScrollViewer Padding="20">
        <StackPanel MaxWidth="700"
                    HorizontalAlignment="Left">

            <Border Style="{StaticResource SectionCardBorderStyle}">
                <StackPanel>

                    <TextBlock Text="ADD HEIR / BENEFICIARY"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <TextBlock Text="Full Name"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding NewBeneficiaryFullName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Identity Number"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding NewBeneficiaryIdNumber, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}"
                             ToolTip="13-digit SA ID number, or a passport number for foreign nationals"/>

                    <TextBlock Text="{Binding NewBeneficiaryIdHint}"
                               Style="{StaticResource InputHintStyle}"
                               Visibility="{Binding NewBeneficiaryIdHint, Converter={StaticResource StringToVisConverter}}"/>

                    <TextBlock Text="Email"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding NewBeneficiaryEmail, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Relationship"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding NewBeneficiaryRelationship, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Heir Type"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding NewBeneficiaryHeirType, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Content="+ Add Beneficiary"
                            Command="{Binding AddBeneficiaryCommand}"
                            Background="#6E2A2A"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="14,7"
                            FontFamily="{StaticResource SansFont}"
                            FontSize="12"
                            Cursor="Hand"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Estate.Beneficiaries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="{Binding FullName}"
                                               FontFamily="{StaticResource SerifFont}"
                                               FontSize="15"
                                               Foreground="#16181C"/>

                                    <TextBlock Text="{Binding IdNumber, StringFormat='ID: {0}'}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="#6B6E76"
                                               Margin="0,2,0,4"/>

                                    <TextBlock Text="{Binding Email}"
                                               FontFamily="{StaticResource SansFont}"
                                               FontSize="11"
                                               Foreground="#6B6E76"
                                               Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="{Binding Relationship}"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,0,16,0"/>

                                        <Border Background="#F5F4F1"
                                                BorderBrush="#E4E2DD"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Padding="6,2">

                                            <TextBlock Text="{Binding HeirType}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10"
                                                       Foreground="#6B6E76"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <Button Content="Invite to portal"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            ToolTip="Email this heir a link to follow the estate's progress online"
                                            Command="{Binding DataContext.InviteBeneficiaryToPortalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding BeneficiaryId}"
                                            Margin="0,0,0,8"/>

                                    <Button Content="Remove"
                                            Style="{StaticResource RemoveLinkButtonStyle}"
                                            HorizontalAlignment="Right"
                                            Command="{Binding DataContext.DeleteBeneficiaryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding BeneficiaryId}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</UserControl>
