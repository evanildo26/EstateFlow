<UserControl x:Class="EstateFlow.Desktop.Views.EstateTabs.CorrespondenceTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext: EstateDetailViewModel (inherited from EstateDetailView). -->

    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CORRESPONDENCE HISTORY" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                    <TextBlock Text="Every email and letter sent from EstateFlow for this estate: diary emails, letters, monthly reports and portal invitations."
                               Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh"
                        Style="{StaticResource OutlineButtonStyle}"
                        VerticalAlignment="Top"
                        Command="{Binding RefreshCorrespondenceCommand}"/>
            </Grid>

            <TextBlock Text="{Binding CorrespondenceMessage}"
                       Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12"
                       Visibility="{Binding CorrespondenceMessage, Converter={StaticResource StringToVisConverter}}"/>

            <ItemsControl ItemsSource="{Binding Correspondence}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SectionCardBorderStyle}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding SentAtUtc, StringFormat='{}{0:dd MMM yyyy}', ConverterCulture=en-ZA}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#16181C"/>
                                    <TextBlock Text="{Binding Channel}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="#9CA0A8" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="StatusText" Text="{Binding Status}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="#3F5B45" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Subject}" FontFamily="{StaticResource SansFont}" FontSize="13" Foreground="#16181C" TextWrapping="Wrap"/>
                                    <TextBlock FontFamily="{StaticResource SansFont}" FontSize="11" Foreground="#6B6E76" Margin="0,3,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding Kind, Mode=OneWay}"/><Run Text=" · to "/><Run Text="{Binding RecipientName, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding RecipientEmail, Mode=OneWay}" Foreground="#9CA0A8"/><Run Text=" · by "/><Run Text="{Binding SentBy, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Summary}" FontFamily="{StaticResource SansFont}" FontSize="11" Foreground="#9CA0A8"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding Summary, Converter={StaticResource StringToVisConverter}}"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="Open letter"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        VerticalAlignment="Top"
                                        Command="{Binding DataContext.OpenCorrespondenceDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding DocumentId, Converter={StaticResource NullToVisConverter}}"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                <Setter TargetName="StatusText" Property="Foreground" Value="#8B3A3A"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
