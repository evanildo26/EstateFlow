<UserControl x:Class="EstateFlow.Desktop.Views.EstateTabs.DiaryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext: EstateDetailViewModel (inherited from EstateDetailView). -->

    <ScrollViewer Padding="20"
                  VerticalScrollBarVisibility="Auto">

        <StackPanel MaxWidth="700"
                    HorizontalAlignment="Left">

            <!-- ADD DIARY ENTRY -->

            <Border Style="{StaticResource SectionCardBorderStyle}">
                <StackPanel>

                    <TextBlock Text="ADD DIARY ENTRY"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <TextBlock Text="Note"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding NewDiaryNote, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="65"/>

                    <TextBlock Text="Due Date"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <DatePicker SelectedDate="{Binding NewDiaryDueDate, Mode=TwoWay}"
                                FontFamily="{StaticResource SansFont}"
                                FontSize="12"
                                Padding="6"
                                Margin="0,0,0,10"/>

                    <TextBlock Text="Remind me by"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <ComboBox SelectedValue="{Binding NewDiaryNotifyBy, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              FontFamily="{StaticResource SansFont}"
                              FontSize="12"
                              Padding="6"
                              Margin="0,0,0,4"
                              AutomationProperties.Name="Remind me by">

                        <ComboBoxItem Content="Email and Dashboard" Tag="Both"/>
                        <ComboBoxItem Content="Dashboard only" Tag="InApp"/>
                        <ComboBoxItem Content="Email only" Tag="Email"/>
                    </ComboBox>

                    <TextBlock Text="Email reminders arrive each morning once an entry is due within 7 days or overdue. The Dashboard lists every open entry under &quot;Overdue / Due this week&quot;."
                               FontFamily="{StaticResource SansFont}"
                               FontSize="11"
                               Foreground="#9CA0A8"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <Button Content="+ Add Diary Entry"
                            Command="{Binding AddDiaryEntryCommand}"
                            Background="#6E2A2A"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="14,7"
                            FontFamily="{StaticResource SansFont}"
                            FontSize="12"
                            Cursor="Hand"
                            HorizontalAlignment="Left"/>

                </StackPanel>
            </Border>

            <!-- EXISTING DIARY ENTRIES -->

            <ItemsControl ItemsSource="{Binding Estate.DiaryEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,20,0">

                                    <TextBlock Text="{Binding Note}"
                                               Style="{StaticResource FieldValueStyle}"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding DueDate, StringFormat='Due: {0:dd MMM yyyy}'}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="#6B6E76"
                                               Margin="0,6,0,0"/>

                                    <TextBlock Text="{Binding NotifyBy, StringFormat='Notify by: {0}'}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="#9CA0A8"
                                               Margin="0,3,0,0"/>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,8,0,0">

                                        <TextBlock Text="Status: "
                                                   FontFamily="{StaticResource SansFont}"
                                                   FontSize="11"
                                                   Foreground="#6B6E76"/>

                                        <TextBlock Text="{Binding IsCompleted, StringFormat='Completed: {0}'}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11"
                                                   Foreground="#6E2A2A"/>
                                    </StackPanel>

                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <Button Content="Open / Read"
                                            Command="{Binding DataContext.OpenDiaryEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderBrush="#E4E2DD"
                                            BorderThickness="1"
                                            Foreground="#16181C"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="11"
                                            Padding="10,6"
                                            Cursor="Hand"
                                            Margin="0,0,0,7"/>

                                    <Button Content="Complete / Reopen"
                                            Command="{Binding DataContext.ToggleDiaryCompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderBrush="#E4E2DD"
                                            BorderThickness="1"
                                            Foreground="#16181C"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="11"
                                            Padding="10,6"
                                            Cursor="Hand"
                                            Margin="0,0,0,7"/>

                                    <Button Content="Remove"
                                            Command="{Binding DataContext.DeleteDiaryEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding DiaryId}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#8B3A3A"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="11"
                                            Padding="10,6"
                                            Cursor="Hand"/>

                                </StackPanel>
                            </Grid>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</UserControl>
