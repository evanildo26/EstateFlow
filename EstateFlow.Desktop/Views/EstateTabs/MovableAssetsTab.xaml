<UserControl x:Class="EstateFlow.Desktop.Views.EstateTabs.MovableAssetsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext: EstateDetailViewModel (inherited from EstateDetailView). -->

    <ScrollViewer Padding="20">
        <StackPanel MaxWidth="700"
                    HorizontalAlignment="Left">

            <Border Style="{StaticResource SectionCardBorderStyle}">
                <StackPanel>

                    <TextBlock Text="ADD MOVABLE ASSET"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <TextBlock Text="Description"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding NewAssetDescription, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Asset Type"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding NewAssetType, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Value (R)"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding NewAssetValue, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}"/>

                    <CheckBox Content="Is Vehicle"
                              IsChecked="{Binding NewAssetIsVehicle}"
                              FontFamily="{StaticResource SansFont}"
                              FontSize="12"
                              Margin="0,0,0,10"/>

                    <StackPanel Visibility="{Binding NewAssetIsVehicle, Converter={StaticResource BoolToVisConverter}}">

                        <TextBlock Text="Registration Number"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Style="{StaticResource QuickAddTextBox}"
                                 Text="{Binding NewAssetRegistrationNumber, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource MonoFont}"/>

                        <TextBlock Text="VIN"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Style="{StaticResource QuickAddTextBox}"
                                 Text="{Binding NewAssetVinNumber, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource MonoFont}"/>

                        <TextBlock Text="Make"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox Style="{StaticResource QuickAddTextBox}"
                                 Text="{Binding NewAssetMake, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Button Content="+ Add Asset"
                            Command="{Binding AddMovableAssetCommand}"
                            Background="#6E2A2A"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="14,7"
                            FontFamily="{StaticResource SansFont}"
                            FontSize="12"
                            Cursor="Hand"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Estate.MovableAssets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource FieldValueStyle}"/>

                                    <TextBlock Text="{Binding Value, StringFormat='R {0:N2}'}"
                                               Style="{StaticResource FieldValueMonoStyle}"
                                               Margin="0,4,0,10"/>

                                    <Grid Style="{StaticResource FieldRowGrid}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Registration No."
                                                   Style="{StaticResource FieldLabelStyle}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RegistrationNumber}"
                                                   Style="{StaticResource FieldValueMonoStyle}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource FieldRowGrid}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="VIN"
                                                   Style="{StaticResource FieldLabelStyle}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding VinNumber}"
                                                   Style="{StaticResource FieldValueMonoStyle}"/>
                                    </Grid>

                                    <Grid Style="{StaticResource FieldRowGrid}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Make"
                                                   Style="{StaticResource FieldLabelStyle}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Make}"
                                                   Style="{StaticResource FieldValueStyle}"/>
                                    </Grid>

                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Top">

                                    <Button Content="Generate Traffic Letter"
                                            Command="{Binding DataContext.GenerateVehicleLetterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding AssetId}"
                                            Background="#6E2A2A"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="11"
                                            Padding="10,6"
                                            Cursor="Hand"
                                            Margin="0,0,0,8"/>

                                    <Button Content="Remove"
                                            Command="{Binding DataContext.DeleteMovableAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding AssetId}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#8B3A3A"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="11"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</UserControl>
