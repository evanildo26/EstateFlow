<UserControl x:Class="EstateFlow.Desktop.Views.EstateTabs.TimelineTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext: EstateDetailViewModel (inherited from EstateDetailView). -->

    <ScrollViewer Padding="20"
                  VerticalScrollBarVisibility="Auto">

        <StackPanel MaxWidth="860"
                    HorizontalAlignment="Left">

            <!-- CURRENT PROGRESS SUMMARY -->

            <Border Style="{StaticResource SectionCardBorderStyle}"
                    Background="#FBFAF8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,24,0">
                        <TextBlock Text="CURRENT ESTATE PROGRESS"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="{Binding CurrentProgressTitle}"
                                   FontFamily="{StaticResource SerifFont}"
                                   FontSize="22"
                                   Foreground="#16181C"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding CurrentProgressSummary}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="#6B6E76"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#EFEAE4"
                            CornerRadius="3"
                            Padding="10,6"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding CurrentProgressStatus}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   Foreground="#6E2A2A"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ADD UPDATE -->

            <Border Style="{StaticResource SectionCardBorderStyle}"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="ADD PROGRESS UPDATE"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <TextBlock Text="Record anything important that happened on the estate — calls, reports sent, documents received, follow-ups, submissions or the current stage."
                               FontFamily="{StaticResource SansFont}"
                               FontSize="12"
                               Foreground="#6B6E76"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Progress Update"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                                     Text="{Binding NewStageName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Example: Report sent to heirs"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Date"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding NewStageTargetDate, Mode=TwoWay}"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Padding="6"
                                        Margin="0,0,0,10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox SelectedValue="{Binding NewStageStatus, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      FontFamily="{StaticResource SansFont}"
                                      FontSize="12"
                                      Padding="6"
                                      Margin="0,0,0,10">
                                <ComboBoxItem Content="Pending" Tag="Pending"/>
                                <ComboBoxItem Content="In Progress" Tag="InProgress"/>
                                <ComboBoxItem Content="Complete" Tag="Complete"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Button Content="+ Add Progress Update"
                            Command="{Binding AddProgressStageCommand}"
                            Background="#6E2A2A"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="14,8"
                            FontFamily="{StaticResource SansFont}"
                            FontSize="12"
                            Cursor="Hand"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- EDIT SELECTED UPDATE -->

            <Border Style="{StaticResource SectionCardBorderStyle}"
                    Margin="0,16,0,0"
                    Background="#FFFDF9"
                    Visibility="{Binding IsEditingProgress, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <TextBlock Text="EDIT SELECTED UPDATE"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Progress Update"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                                     Text="{Binding EditingProgressTitle, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Date"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding EditingProgressDate, Mode=TwoWay}"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Padding="6"
                                        Margin="0,0,0,10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox SelectedValue="{Binding EditingProgressStatus, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      FontFamily="{StaticResource SansFont}"
                                      FontSize="12"
                                      Padding="6"
                                      Margin="0,0,0,10">
                                <ComboBoxItem Content="Pending" Tag="Pending"/>
                                <ComboBoxItem Content="In Progress" Tag="InProgress"/>
                                <ComboBoxItem Content="Complete" Tag="Complete"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save Changes"
                                Command="{Binding SaveProgressStageCommand}"
                                Background="#16181C"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="14,8"
                                FontFamily="{StaticResource SansFont}"
                                FontSize="12"
                                Cursor="Hand"
                                Margin="0,0,10,0"/>

                        <Button Content="Cancel"
                                Command="{Binding CancelProgressEditCommand}"
                                Background="Transparent"
                                BorderBrush="#E4E2DD"
                                BorderThickness="1"
                                Foreground="#16181C"
                                Padding="14,8"
                                FontFamily="{StaticResource SansFont}"
                                FontSize="12"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- TIMELINE -->

            <TextBlock Text="PROGRESS TIMELINE"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,24,0,10"/>

            <ItemsControl ItemsSource="{Binding Estate.ProgressStages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding TargetDate, StringFormat='{}{0:dd MMM yyyy}'}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="#6B6E76"
                                       HorizontalAlignment="Right"
                                       Margin="0,15,12,0"/>

                            <Grid Grid.Column="1">
                                <Border Width="1"
                                        Background="#D8D5CF"
                                        HorizontalAlignment="Center"/>
                                <Ellipse Width="10"
                                         Height="10"
                                         Fill="#6E2A2A"
                                         VerticalAlignment="Top"
                                         Margin="0,16,0,0"/>
                            </Grid>

                            <Border Grid.Column="2"
                                    Style="{StaticResource SectionCardBorderStyle}"
                                    Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,20,0">
                                        <TextBlock Text="{Binding StageName}"
                                                   FontFamily="{StaticResource SerifFont}"
                                                   FontSize="16"
                                                   Foreground="#16181C"
                                                   TextWrapping="Wrap"/>

                                        <Border Background="#F5F4F1"
                                                BorderBrush="#E4E2DD"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Padding="8,3"
                                                HorizontalAlignment="Left"
                                                Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Status}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10"
                                                       Foreground="#6E2A2A"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="Edit"
                                                Command="{Binding DataContext.EditProgressStageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderBrush="#E4E2DD"
                                                BorderThickness="1"
                                                Foreground="#16181C"
                                                FontFamily="{StaticResource SansFont}"
                                                FontSize="11"
                                                Padding="10,6"
                                                Cursor="Hand"
                                                Margin="0,0,8,0"/>

                                        <Button Content="Remove"
                                                Command="{Binding DataContext.DeleteProgressStageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding StageId}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="#8B3A3A"
                                                FontFamily="{StaticResource SansFont}"
                                                FontSize="11"
                                                Padding="10,6"
                                                Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</UserControl>
