<UserControl x:Class="EstateFlow.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="EstateRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#E4E2DD" BorderThickness="0,0,0,1"
                                Padding="0,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EDEAE5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="#EDEAE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource MonoLabelStyle}">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#9CA0A8"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F4F1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" BorderBrush="#E4E2DD" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Estate Registry" FontFamily="{StaticResource SerifFont}" FontSize="17" Foreground="#16181C"/>
                    <TextBlock Text="{Binding SummaryText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#6B6E76" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadEstatesCommand}"
                        Style="{StaticResource OutlineButtonStyle}" FontSize="12" Padding="12,7" Margin="0,0,10,0"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="2" Content="+ New Estate" Command="{Binding NewEstateCommand}"
                        Background="#6E2A2A" Foreground="White" BorderThickness="0"
                        Padding="14,8" FontFamily="{StaticResource SansFont}" FontSize="12" Cursor="Hand"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Search / filter / sort -->
        <Border Grid.Row="1" BorderBrush="#E4E2DD" BorderThickness="0,0,0,1" Padding="24,10" Background="#F0EEE9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="360"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="12"
                             AutomationProperties.Name="Search by name, file number or status"/>
                    <TextBlock Text="Search name, file number or status…" IsHitTestVisible="False"
                               Margin="11,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource SansFont}" FontSize="12" Foreground="#9CA0A8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"
                          Width="160" Margin="10,0,0,0" Padding="8,5" FontFamily="{StaticResource SansFont}" FontSize="12"
                          AutomationProperties.Name="Show"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <TextBlock Text="Sort" VerticalAlignment="Center" Margin="0,0,6,0"
                               FontFamily="{StaticResource SansFont}" FontSize="12" Foreground="#6B6E76"/>
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortOption}"
                              Width="190" Padding="8,5" FontFamily="{StaticResource SansFont}" FontSize="12"
                              AutomationProperties.Name="Sort by"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Estates + due panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column header -->
                <Grid Grid.Row="0" Background="#F0EEE9" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="FILE NO." Style="{StaticResource ColumnHeaderStyle}"/>
                    <TextBlock Grid.Column="2" Text="DECEASED" Style="{StaticResource ColumnHeaderStyle}"/>
                    <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource ColumnHeaderStyle}"/>
                    <TextBlock Grid.Column="4" Text="PROGRESS" Style="{StaticResource ColumnHeaderStyle}"/>
                    <TextBlock Grid.Column="5" Text="NEXT DEADLINE" Style="{StaticResource ColumnHeaderStyle}"/>
                    <TextBlock Grid.Column="6" Text="DIARY" Style="{StaticResource ColumnHeaderStyle}"/>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                           FontFamily="{StaticResource SansFont}" FontSize="12" Foreground="#6B6E76" Margin="24,14"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisConverter}}"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Estates}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource EstateRowButtonStyle}"
                                        Command="{Binding DataContext.OpenEstateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding EstateId}"
                                        AutomationProperties.Name="{Binding DeceasedFullName, StringFormat='Open estate of {0}'}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Attention marker -->
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#8B3A3A"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 ToolTip="{Binding AttentionReason}"
                                                 Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisConverter}}"/>

                                        <TextBlock Grid.Column="1" Text="{Binding FileNumber}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#16181C"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeceasedFullName}" FontFamily="{StaticResource SerifFont}" FontSize="13" Foreground="#16181C"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AttentionReason}" FontFamily="{StaticResource SansFont}" FontSize="10" Foreground="#8B3A3A"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding AttentionReason}"
                                                       Visibility="{Binding AttentionReason, Converter={StaticResource StringToVisConverter}}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding EstateStatus}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#6E2A2A"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ProgressBar Width="56" Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                                         Foreground="#3F5B45" Background="#ECEAE5" BorderThickness="0"/>
                                            <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="#6B6E76" Margin="6,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,8,0"
                                                    ToolTip="{Binding NextMilestoneTitle}">
                                            <TextBlock Text="{Binding NextDeadline, StringFormat='{}{0:d MMM yyyy}', TargetNullValue='—'}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#16181C"/>
                                            <TextBlock Text="{Binding NextMilestoneTitle}" FontFamily="{StaticResource SansFont}" FontSize="10" Foreground="#9CA0A8"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OpenDiaryCount, StringFormat='{}{0} open'}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#6B6E76"/>
                                            <TextBlock x:Name="Overdue" Text="{Binding OverdueDiaryCount, StringFormat='{}{0} late'}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="#8B3A3A"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding OverdueDiaryCount}" Value="0">
                                        <Setter TargetName="Overdue" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Overdue / Due this week -->
            <Border Grid.Column="1" BorderBrush="#E4E2DD" BorderThickness="1,0,0,0" Background="#FBFAF8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="16,14,16,8">
                        <TextBlock Text="OVERDUE / DUE THIS WEEK" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        <TextBlock Text="{Binding DueSummary}" FontFamily="{StaticResource SansFont}" FontSize="12" Foreground="#6B6E76"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DueItems}" Margin="8,0,8,12" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenEstateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding EstateId}"
                                            Cursor="Hand" HorizontalContentAlignment="Stretch" Margin="0,0,0,6"
                                            Background="White" BorderBrush="#E4E2DD" BorderThickness="1" Padding="10,8"
                                            ToolTip="{Binding Note}">
                                        <StackPanel>
                                            <TextBlock x:Name="When" Text="{Binding WhenText}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="#9C7A3C"/>
                                            <TextBlock Text="{Binding Note}" FontFamily="{StaticResource SansFont}" FontSize="12" Foreground="#16181C"
                                                       TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,3,0,3"/>
                                            <TextBlock FontFamily="{StaticResource SansFont}" FontSize="10" Foreground="#9CA0A8" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding FileNumber, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DeceasedFullName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter TargetName="When" Property="Foreground" Value="#8B3A3A"/>
                                            <Setter TargetName="When" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
