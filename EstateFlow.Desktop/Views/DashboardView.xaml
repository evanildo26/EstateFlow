<UserControl x:Class="EstateFlow.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="EstateRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#E4E2DD" BorderThickness="0,0,0,1"
                                Padding="0,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EDEAE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F4F1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" BorderBrush="#E4E2DD" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Estate Registry" FontFamily="{StaticResource SerifFont}" FontSize="17" Foreground="#16181C"/>
                    <TextBlock Text="{Binding StatusMessage}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#6B6E76" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="+ New Estate" Command="{Binding NewEstateCommand}"
                        Background="#6E2A2A" Foreground="White" BorderThickness="0"
                        Padding="14,8" FontFamily="{StaticResource SansFont}" FontSize="12" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Column header -->
        <Grid Grid.Row="1" Background="#F0EEE9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="FILE NO." Style="{StaticResource MonoLabelStyle}" FontSize="9" Foreground="#9CA0A8" Margin="24,8,0,8"/>
            <TextBlock Grid.Column="1" Text="DECEASED" Style="{StaticResource MonoLabelStyle}" FontSize="9" Foreground="#9CA0A8" Margin="0,8,0,8"/>
            <TextBlock Grid.Column="2" Text="STATUS" Style="{StaticResource MonoLabelStyle}" FontSize="9" Foreground="#9CA0A8" Margin="0,8,0,8"/>
            <TextBlock Grid.Column="3" Text="OPEN DIARY" Style="{StaticResource MonoLabelStyle}" FontSize="9" Foreground="#9CA0A8" Margin="0,8,0,8"/>
            <TextBlock Grid.Column="4" Text="CONTROLLER" Style="{StaticResource MonoLabelStyle}" FontSize="9" Foreground="#9CA0A8" Margin="0,8,24,8"/>
        </Grid>

        <!-- Rows -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Estates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource EstateRowButtonStyle}"
                                Command="{Binding DataContext.OpenEstateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding EstateId}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding FileNumber}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#16181C" Margin="24,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding DeceasedFullName}" FontFamily="{StaticResource SerifFont}" FontSize="13" Foreground="#16181C"/>
                                <TextBlock Grid.Column="2" Text="{Binding EstateStatus}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#6E2A2A"/>
                                <TextBlock Grid.Column="3" Text="{Binding OpenDiaryCount}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#6B6E76"/>
                                <TextBlock Grid.Column="4" Text="{Binding ControllerName}" FontFamily="{StaticResource SansFont}" FontSize="12" Foreground="#6B6E76" Margin="0,0,24,0"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>