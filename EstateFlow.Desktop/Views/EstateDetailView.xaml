<UserControl x:Class="EstateFlow.Desktop.Views.EstateDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:EstateFlow.Desktop.Views.EstateTabs">

    <!--
        The estate screen. Each tab is its own UserControl in Views/EstateTabs,
        bound to the same EstateDetailViewModel (split into partial classes
        per area in Mvvm/EstateDetailViewModel.*.cs).
    -->

    <Grid Background="#F5F4F1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                BorderBrush="#E4E2DD"
                BorderThickness="0,0,0,1"
                Padding="24,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="0">

                    <Button Content="← Dashboard"
                            Command="{Binding BackCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#6B6E76"
                            FontFamily="{StaticResource SansFont}"
                            FontSize="12"
                            Cursor="Hand"
                            Padding="0,0,16,0"
                            AutomationProperties.Name="Back to dashboard"/>

                    <TextBlock Text="{Binding Estate.FileNumber, StringFormat='File {0}'}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="12"
                               Foreground="#6B6E76"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBlock Text="{Binding Estate.Deceased.FullName, StringFormat='Estate of the Late {0}'}"
                               FontFamily="{StaticResource SerifFont}"
                               FontSize="16"
                               Foreground="#16181C"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding Estate.Progress.PercentComplete, StringFormat='{}{0}% complete'}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               Foreground="#3F5B45"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>

                    <TextBlock Text="{Binding Estate.EstateStatus}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               Foreground="#9C7A3C"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Attention banner from the stage checklist -->
                <Border Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Background="#F6E9E9"
                        BorderBrush="#E2C6C6"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10,6"
                        Margin="0,10,0,0"
                        Visibility="{Binding Estate.Progress.NeedsAttention, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding Estate.Progress.AttentionReason, StringFormat='Needs attention — {0}'}"
                               FontFamily="{StaticResource SansFont}"
                               FontSize="12"
                               Foreground="#8B3A3A"
                               TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===================================================== -->
        <!-- TABS -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Status / validation messages, above the tabs so they never cover content -->
            <Border Grid.Row="0"
                    Background="#EFEAE4"
                    Padding="24,6"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisConverter}}">
                <TextBlock Text="{Binding StatusMessage}"
                           FontFamily="{StaticResource SansFont}"
                           FontSize="12"
                           Foreground="#16181C"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
            </Border>

            <TabControl Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="{Binding Estate, Converter={StaticResource NullToVisConverter}}">

                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="10,8"/>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="General">
                    <tabs:GeneralTab/>
                </TabItem>

                <TabItem Header="Checklist">
                    <tabs:ChecklistTab/>
                </TabItem>

                <TabItem Header="Deceased">
                    <tabs:DeceasedTab/>
                </TabItem>

                <TabItem Header="Executors">
                    <tabs:ExecutorsTab/>
                </TabItem>

                <TabItem Header="Heirs">
                    <tabs:HeirsTab/>
                </TabItem>

                <TabItem Header="Movable">
                    <tabs:MovableAssetsTab/>
                </TabItem>

                <TabItem Header="Immovable">
                    <tabs:ImmovablePropertiesTab/>
                </TabItem>

                <TabItem Header="Claims">
                    <tabs:FinancialClaimsTab/>
                </TabItem>

                <TabItem Header="Liabilities">
                    <tabs:LiabilitiesTab/>
                </TabItem>

                <TabItem Header="Diary">
                    <tabs:DiaryTab/>
                </TabItem>

                <TabItem Header="Timeline">
                    <tabs:TimelineTab/>
                </TabItem>

                <TabItem Header="Correspondence">
                    <tabs:CorrespondenceTab/>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</UserControl>
