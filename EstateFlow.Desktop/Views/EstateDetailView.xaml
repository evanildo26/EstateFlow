<UserControl x:Class="EstateFlow.Desktop.Views.EstateDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="FieldRowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="QuickAddTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F4F1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                BorderBrush="#E4E2DD"
                BorderThickness="0,0,0,1"
                Padding="24,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="0">

                    <Button Content="← Dashboard"
                            Command="{Binding BackCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#6B6E76"
                            FontFamily="{StaticResource SansFont}"
                            FontSize="12"
                            Cursor="Hand"
                            Padding="0,0,16,0"/>

                    <TextBlock Text="{Binding Estate.FileNumber, StringFormat='File {0}'}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="12"
                               Foreground="#6B6E76"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBlock Text="{Binding Estate.Deceased.FullName, StringFormat='Estate of the Late {0}'}"
                               FontFamily="{StaticResource SerifFont}"
                               FontSize="16"
                               Foreground="#16181C"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding Estate.EstateStatus}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="#9C7A3C"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Loading / error -->

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="12"
                   Foreground="#9CA0A8"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,40,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisConverter}}"/>

        <!-- ===================================================== -->
        <!-- TABS -->
        <!-- ===================================================== -->

        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Visibility="{Binding Estate, Converter={StaticResource NullToVisConverter}}">

            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="10,8"/>
                </Style>
            </TabControl.Resources>

            <!-- ================================================= -->
            <!-- GENERAL -->
            <!-- ================================================= -->

            <TabItem Header="General">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="700"
                                HorizontalAlignment="Left">

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>

                                <TextBlock Text="FILE REFERENCE"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="File Number"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.FileNumber}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Master's Reference"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.MastersReference}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Date of Death"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.DateOfDeath, StringFormat='dd MMMM yyyy'}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Dutiable Estate"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.IsDutiable}"
                                               Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Status"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.EstateStatus}"
                                               Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardBorderStyle}"
                                Margin="0,18,0,0"
                                Background="#FBFAF8">
                            <StackPanel>
                                <TextBlock Text="CURRENT PROGRESS"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="{Binding CurrentProgressTitle}"
                                           FontFamily="{StaticResource SerifFont}"
                                           FontSize="19"
                                           Foreground="#16181C"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#EFEAE4"
                                            CornerRadius="3"
                                            Padding="8,4"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding CurrentProgressStatus}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   Foreground="#6E2A2A"/>
                                    </Border>

                                    <TextBlock Text="{Binding CurrentProgressSummary}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="#6B6E76"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Manage and edit the full estate timeline from the Progress tab."
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="11"
                                           Foreground="#9CA0A8"
                                           Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardBorderStyle}"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="ESTATE OVERVIEW"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Deceased"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.Deceased.FullName}"
                                               Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Executors"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.Executors.Count}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Heirs / Beneficiaries"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.Beneficiaries.Count}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Movable Assets"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.MovableAssets.Count}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Immovable Properties"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.ImmovableProperties.Count}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Financial Claims"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.FinancialClaims.Count}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Diary Entries"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.DiaryEntries.Count}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Progress Stages"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.ProgressStages.Count}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardBorderStyle}"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="ESTATE ACTIONS"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Edit the estate details or permanently remove this estate."
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="12"
                                           Foreground="#6B6E76"
                                           Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit Estate"
                                            Command="{Binding EditCommand}"
                                            Background="Transparent"
                                            BorderThickness="1"
                                            BorderBrush="#E4E2DD"
                                            Foreground="#16181C"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="12"
                                            Padding="14,7"
                                            Cursor="Hand"
                                            Margin="0,0,10,0"/>

                                    <Button Content="Delete Estate"
                                            Command="{Binding DeleteEstateCommand}"
                                            Background="#8B3A3A"
                                            BorderThickness="0"
                                            Foreground="White"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="12"
                                            Padding="14,7"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- DECEASED -->
            <!-- ================================================= -->

            <TabItem Header="Deceased">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="700"
                                HorizontalAlignment="Left">

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>

                                <TextBlock Text="PARTICULARS OF THE DECEASED"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Full Names"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.Deceased.FullName}"
                                               Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Identity Number"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.Deceased.IdNumber}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Marital Status"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.Deceased.MaritalStatus}"
                                               Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- EXECUTORS -->
            <!-- ================================================= -->

            <TabItem Header="Executors">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="700"
                                HorizontalAlignment="Left">

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>

                                <TextBlock Text="ADD EXECUTOR"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Full Name"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewExecutorFullName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Identity Number"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewExecutorIdNumber, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource MonoFont}"/>

                                <TextBlock Text="Email"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewExecutorEmail, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Role"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewExecutorRole, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Content="+ Add Executor"
                                        Command="{Binding AddExecutorCommand}"
                                        Background="#6E2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,7"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Estate.Executors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SectionCardBorderStyle}">
                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <TextBlock Text="{Binding FullName}"
                                                           FontFamily="{StaticResource SerifFont}"
                                                           FontSize="15"
                                                           Foreground="#16181C"
                                                           Margin="0,0,0,10"/>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Identity Number"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding IdNumber}"
                                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                                </Grid>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Email"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Email}"
                                                               Style="{StaticResource FieldValueStyle}"/>
                                                </Grid>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Role"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Role}"
                                                               Style="{StaticResource FieldValueStyle}"/>
                                                </Grid>

                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Remove"
                                                    Command="{Binding DataContext.DeleteExecutorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding ExecutorId}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#8B3A3A"
                                                    FontFamily="{StaticResource SansFont}"
                                                    FontSize="11"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- HEIRS -->
            <!-- ================================================= -->

            <TabItem Header="Heirs">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="700"
                                HorizontalAlignment="Left">

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>

                                <TextBlock Text="ADD HEIR / BENEFICIARY"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Full Name"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryFullName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Identity Number"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryIdNumber, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource MonoFont}"/>

                                <TextBlock Text="Email"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryEmail, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Relationship"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryRelationship, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Heir Type"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryHeirType, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Content="+ Add Beneficiary"
                                        Command="{Binding AddBeneficiaryCommand}"
                                        Background="#6E2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,7"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Estate.Beneficiaries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SectionCardBorderStyle}">
                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <TextBlock Text="{Binding FullName}"
                                                           FontFamily="{StaticResource SerifFont}"
                                                           FontSize="15"
                                                           Foreground="#16181C"/>

                                                <TextBlock Text="{Binding IdNumber, StringFormat='ID: {0}'}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           Foreground="#6B6E76"
                                                           Margin="0,2,0,4"/>

                                                <TextBlock Text="{Binding Email}"
                                                           FontFamily="{StaticResource SansFont}"
                                                           FontSize="11"
                                                           Foreground="#6B6E76"
                                                           Margin="0,0,0,8"/>

                                                <StackPanel Orientation="Horizontal">

                                                    <TextBlock Text="{Binding Relationship}"
                                                               Style="{StaticResource FieldLabelStyle}"
                                                               Margin="0,0,16,0"/>

                                                    <Border Background="#F5F4F1"
                                                            BorderBrush="#E4E2DD"
                                                            BorderThickness="1"
                                                            CornerRadius="2"
                                                            Padding="6,2">

                                                        <TextBlock Text="{Binding HeirType}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="10"
                                                                   Foreground="#6B6E76"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Remove"
                                                    Command="{Binding DataContext.DeleteBeneficiaryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding BeneficiaryId}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#8B3A3A"
                                                    FontFamily="{StaticResource SansFont}"
                                                    FontSize="11"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- MOVABLE ASSETS -->
            <!-- ================================================= -->

            <TabItem Header="Movable">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="700"
                                HorizontalAlignment="Left">

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>

                                <TextBlock Text="ADD MOVABLE ASSET"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Description"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewAssetDescription, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Asset Type"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewAssetType, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Value (R)"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewAssetValue, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource MonoFont}"/>

                                <CheckBox Content="Is Vehicle"
                                          IsChecked="{Binding NewAssetIsVehicle}"
                                          FontFamily="{StaticResource SansFont}"
                                          FontSize="12"
                                          Margin="0,0,0,10"/>

                                <StackPanel Visibility="{Binding NewAssetIsVehicle, Converter={StaticResource BoolToVisConverter}}">

                                    <TextBlock Text="Registration Number"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBox Style="{StaticResource QuickAddTextBox}"
                                             Text="{Binding NewAssetRegistrationNumber, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource MonoFont}"/>

                                    <TextBlock Text="VIN"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBox Style="{StaticResource QuickAddTextBox}"
                                             Text="{Binding NewAssetVinNumber, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource MonoFont}"/>

                                    <TextBlock Text="Make"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBox Style="{StaticResource QuickAddTextBox}"
                                             Text="{Binding NewAssetMake, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <Button Content="+ Add Asset"
                                        Command="{Binding AddMovableAssetCommand}"
                                        Background="#6E2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,7"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Estate.MovableAssets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SectionCardBorderStyle}">
                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource FieldValueStyle}"/>

                                                <TextBlock Text="{Binding Value, StringFormat='R {0:N2}'}"
                                                           Style="{StaticResource FieldValueMonoStyle}"
                                                           Margin="0,4,0,10"/>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Registration No."
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding RegistrationNumber}"
                                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                                </Grid>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="VIN"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding VinNumber}"
                                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                                </Grid>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Make"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Make}"
                                                               Style="{StaticResource FieldValueStyle}"/>
                                                </Grid>

                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Top">

                                                <Button Content="Generate Traffic Letter"
                                                        Command="{Binding DataContext.GenerateVehicleLetterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding AssetId}"
                                                        Background="#6E2A2A"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Padding="10,6"
                                                        Cursor="Hand"
                                                        Margin="0,0,0,8"/>

                                                <Button Content="Remove"
                                                        Command="{Binding DataContext.DeleteMovableAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding AssetId}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="#8B3A3A"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- IMMOVABLE PROPERTIES -->
            <!-- ================================================= -->

            <TabItem Header="Immovable">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="700"
                                HorizontalAlignment="Left">

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>

                                <TextBlock Text="ADD IMMOVABLE PROPERTY"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Description"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewPropertyDescription, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Title Deed Number"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewPropertyTitleDeedNumber, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource MonoFont}"/>

                                <TextBlock Text="Municipal Value (R)"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewPropertyMunicipalValue, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource MonoFont}"/>

                                <Button Content="+ Add Property"
                                        Command="{Binding AddImmovablePropertyCommand}"
                                        Background="#6E2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,7"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Estate.ImmovableProperties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SectionCardBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,20,0">

                                                <TextBlock Text="{Binding Description}"
                                                           FontFamily="{StaticResource SerifFont}"
                                                           FontSize="15"
                                                           Foreground="#16181C"
                                                           Margin="0,0,0,10"/>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Title Deed Number"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding TitleDeedNumber}"
                                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                                </Grid>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Municipal Value"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding MunicipalValue, StringFormat='R {0:N2}'}"
                                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                                </Grid>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Remove"
                                                    Command="{Binding DataContext.DeleteImmovablePropertyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding AssetId}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#8B3A3A"
                                                    FontFamily="{StaticResource SansFont}"
                                                    FontSize="11"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- CLAIMS -->
            <!-- ================================================= -->

            <TabItem Header="Claims">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="700"
                                HorizontalAlignment="Left">

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>

                                <TextBlock Text="ADD FINANCIAL CLAIM"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Institution Name"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewClaimInstitutionName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Institution Address"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewClaimInstitutionAddress, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Account Reference"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewClaimAccountReference, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource MonoFont}"/>

                                <TextBlock Text="Value (R)"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewClaimValue, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource MonoFont}"/>

                                <Button Content="+ Add Claim"
                                        Command="{Binding AddFinancialClaimCommand}"
                                        Background="#6E2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,7"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Estate.FinancialClaims}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SectionCardBorderStyle}">
                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <TextBlock Text="{Binding InstitutionName}"
                                                           FontFamily="{StaticResource SerifFont}"
                                                           FontSize="15"
                                                           Foreground="#16181C"
                                                           Margin="0,0,0,10"/>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Address"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding InstitutionAddress}"
                                                               Style="{StaticResource FieldValueStyle}"/>
                                                </Grid>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Account Reference"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding AccountReference}"
                                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                                </Grid>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Value"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Value, StringFormat='R {0:N2}'}"
                                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                                </Grid>

                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Top">

                                                <Button Content="Generate Institution Letter"
                                                        Command="{Binding DataContext.GenerateInstitutionLetterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding ClaimId}"
                                                        Background="#6E2A2A"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Padding="10,6"
                                                        Cursor="Hand"
                                                        Margin="0,0,0,8"/>

                                                <Button Content="Remove"
                                                        Command="{Binding DataContext.DeleteFinancialClaimCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding ClaimId}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="#8B3A3A"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- DIARY -->
            <!-- ================================================= -->

            <TabItem Header="Diary">
                <ScrollViewer Padding="20"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel MaxWidth="700"
                                HorizontalAlignment="Left">

                        <!-- ADD DIARY ENTRY -->

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>

                                <TextBlock Text="ADD DIARY ENTRY"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Note"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewDiaryNote, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="65"/>

                                <TextBlock Text="Due Date"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <DatePicker SelectedDate="{Binding NewDiaryDueDate, Mode=TwoWay}"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="12"
                                            Padding="6"
                                            Margin="0,0,0,10"/>

                                <TextBlock Text="Notification Method"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <ComboBox SelectedValue="{Binding NewDiaryNotifyBy, Mode=TwoWay}"
                                          SelectedValuePath="Content"
                                          FontFamily="{StaticResource SansFont}"
                                          FontSize="12"
                                          Padding="6"
                                          Margin="0,0,0,12">

                                    <ComboBoxItem Content="InApp"/>
                                    <ComboBoxItem Content="Email"/>
                                    <ComboBoxItem Content="Both"/>
                                </ComboBox>

                                <Button Content="+ Add Diary Entry"
                                        Command="{Binding AddDiaryEntryCommand}"
                                        Background="#6E2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,7"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>

                            </StackPanel>
                        </Border>

                        <!-- EXISTING DIARY ENTRIES -->

                        <ItemsControl ItemsSource="{Binding Estate.DiaryEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Style="{StaticResource SectionCardBorderStyle}">
                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,20,0">

                                                <TextBlock Text="{Binding Note}"
                                                           Style="{StaticResource FieldValueStyle}"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding DueDate, StringFormat='Due: {0:dd MMM yyyy}'}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           Foreground="#6B6E76"
                                                           Margin="0,6,0,0"/>

                                                <TextBlock Text="{Binding NotifyBy, StringFormat='Notify by: {0}'}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10"
                                                           Foreground="#9CA0A8"
                                                           Margin="0,3,0,0"/>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,8,0,0">

                                                    <TextBlock Text="Status: "
                                                               FontFamily="{StaticResource SansFont}"
                                                               FontSize="11"
                                                               Foreground="#6B6E76"/>

                                                    <TextBlock Text="{Binding IsCompleted, StringFormat='Completed: {0}'}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="11"
                                                               Foreground="#6E2A2A"/>
                                                </StackPanel>

                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">

                                                <Button Content="Open / Read"
                                                        Command="{Binding DataContext.OpenDiaryEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderBrush="#E4E2DD"
                                                        BorderThickness="1"
                                                        Foreground="#16181C"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Padding="10,6"
                                                        Cursor="Hand"
                                                        Margin="0,0,0,7"/>

                                                <Button Content="Complete / Reopen"
                                                        Command="{Binding DataContext.ToggleDiaryCompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderBrush="#E4E2DD"
                                                        BorderThickness="1"
                                                        Foreground="#16181C"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Padding="10,6"
                                                        Cursor="Hand"
                                                        Margin="0,0,0,7"/>

                                                <Button Content="Remove"
                                                        Command="{Binding DataContext.DeleteDiaryEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding DiaryId}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="#8B3A3A"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Padding="10,6"
                                                        Cursor="Hand"/>

                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- PROGRESS -->
            <!-- ================================================= -->

            <TabItem Header="Progress">
                <ScrollViewer Padding="20"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel MaxWidth="860"
                                HorizontalAlignment="Left">

                        <!-- CURRENT PROGRESS SUMMARY -->

                        <Border Style="{StaticResource SectionCardBorderStyle}"
                                Background="#FBFAF8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,24,0">
                                    <TextBlock Text="CURRENT ESTATE PROGRESS"
                                               Style="{StaticResource SectionTitleStyle}"/>

                                    <TextBlock Text="{Binding CurrentProgressTitle}"
                                               FontFamily="{StaticResource SerifFont}"
                                               FontSize="22"
                                               Foreground="#16181C"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Text="{Binding CurrentProgressSummary}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="#6B6E76"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="#EFEAE4"
                                        CornerRadius="3"
                                        Padding="10,6"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding CurrentProgressStatus}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="#6E2A2A"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ADD UPDATE -->

                        <Border Style="{StaticResource SectionCardBorderStyle}"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="ADD PROGRESS UPDATE"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Record anything important that happened on the estate — calls, reports sent, documents received, follow-ups, submissions or the current stage."
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="12"
                                           Foreground="#6B6E76"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Progress Update"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Style="{StaticResource QuickAddTextBox}"
                                                 Text="{Binding NewStageName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Example: Report sent to heirs"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Date"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <DatePicker SelectedDate="{Binding NewStageTargetDate, Mode=TwoWay}"
                                                    FontFamily="{StaticResource SansFont}"
                                                    FontSize="12"
                                                    Padding="6"
                                                    Margin="0,0,0,10"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Status"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox SelectedValue="{Binding NewStageStatus, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  FontFamily="{StaticResource SansFont}"
                                                  FontSize="12"
                                                  Padding="6"
                                                  Margin="0,0,0,10">
                                            <ComboBoxItem Content="Pending" Tag="Pending"/>
                                            <ComboBoxItem Content="In Progress" Tag="InProgress"/>
                                            <ComboBoxItem Content="Complete" Tag="Complete"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Button Content="+ Add Progress Update"
                                        Command="{Binding AddProgressStageCommand}"
                                        Background="#6E2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,8"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- EDIT SELECTED UPDATE -->

                        <Border Style="{StaticResource SectionCardBorderStyle}"
                                Margin="0,16,0,0"
                                Background="#FFFDF9"
                                Visibility="{Binding IsEditingProgress, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="EDIT SELECTED UPDATE"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Progress Update"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Style="{StaticResource QuickAddTextBox}"
                                                 Text="{Binding EditingProgressTitle, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Date"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <DatePicker SelectedDate="{Binding EditingProgressDate, Mode=TwoWay}"
                                                    FontFamily="{StaticResource SansFont}"
                                                    FontSize="12"
                                                    Padding="6"
                                                    Margin="0,0,0,10"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Status"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox SelectedValue="{Binding EditingProgressStatus, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  FontFamily="{StaticResource SansFont}"
                                                  FontSize="12"
                                                  Padding="6"
                                                  Margin="0,0,0,10">
                                            <ComboBoxItem Content="Pending" Tag="Pending"/>
                                            <ComboBoxItem Content="In Progress" Tag="InProgress"/>
                                            <ComboBoxItem Content="Complete" Tag="Complete"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save Changes"
                                            Command="{Binding SaveProgressStageCommand}"
                                            Background="#16181C"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="14,8"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="12"
                                            Cursor="Hand"
                                            Margin="0,0,10,0"/>

                                    <Button Content="Cancel"
                                            Command="{Binding CancelProgressEditCommand}"
                                            Background="Transparent"
                                            BorderBrush="#E4E2DD"
                                            BorderThickness="1"
                                            Foreground="#16181C"
                                            Padding="14,8"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="12"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- TIMELINE -->

                        <TextBlock Text="PROGRESS TIMELINE"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,24,0,10"/>

                        <ItemsControl ItemsSource="{Binding Estate.ProgressStages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding TargetDate, StringFormat='{}{0:dd MMM yyyy}'}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11"
                                                   Foreground="#6B6E76"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,15,12,0"/>

                                        <Grid Grid.Column="1">
                                            <Border Width="1"
                                                    Background="#D8D5CF"
                                                    HorizontalAlignment="Center"/>
                                            <Ellipse Width="10"
                                                     Height="10"
                                                     Fill="#6E2A2A"
                                                     VerticalAlignment="Top"
                                                     Margin="0,16,0,0"/>
                                        </Grid>

                                        <Border Grid.Column="2"
                                                Style="{StaticResource SectionCardBorderStyle}"
                                                Margin="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Margin="0,0,20,0">
                                                    <TextBlock Text="{Binding StageName}"
                                                               FontFamily="{StaticResource SerifFont}"
                                                               FontSize="16"
                                                               Foreground="#16181C"
                                                               TextWrapping="Wrap"/>

                                                    <Border Background="#F5F4F1"
                                                            BorderBrush="#E4E2DD"
                                                            BorderThickness="1"
                                                            CornerRadius="2"
                                                            Padding="8,3"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,8,0,0">
                                                        <TextBlock Text="{Binding Status}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="10"
                                                                   Foreground="#6E2A2A"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Edit"
                                                            Command="{Binding DataContext.EditProgressStageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderBrush="#E4E2DD"
                                                            BorderThickness="1"
                                                            Foreground="#16181C"
                                                            FontFamily="{StaticResource SansFont}"
                                                            FontSize="11"
                                                            Padding="10,6"
                                                            Cursor="Hand"
                                                            Margin="0,0,8,0"/>

                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.DeleteProgressStageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding StageId}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="#8B3A3A"
                                                            FontFamily="{StaticResource SansFont}"
                                                            FontSize="11"
                                                            Padding="10,6"
                                                            Cursor="Hand"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>