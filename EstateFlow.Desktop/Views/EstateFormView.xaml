<UserControl x:Class="EstateFlow.Desktop.Views.EstateFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F4F1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#E4E2DD" BorderThickness="0,0,0,1" Padding="24,12">
            <TextBlock Text="{Binding HeaderText}" FontFamily="{StaticResource SerifFont}" FontSize="17" Foreground="#16181C"/>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                <Border Background="#FFFFFF" BorderBrush="#E4E2DD" BorderThickness="1" CornerRadius="4" Padding="20,18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="FILE REFERENCE" Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="File Number" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FileNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,0,14"/>

                        <TextBlock Text="Master's Reference" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding MastersReference, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,0,14"/>

                        <TextBlock Text="Date of Death" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding DateOfDeath}" Padding="8,6" Margin="0,0,0,14"/>

                        <CheckBox Content="Dutiable Estate" IsChecked="{Binding IsDutiable}"
                                  FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,14"/>

                        <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                            <!-- Bound to plain strings: binding SelectedItem to ComboBoxItems used to save
                                 "System.Windows.Controls.ComboBoxItem: In Progress" as the status. -->
                            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding EstateStatus}"
                                      Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,4"
                                      AutomationProperties.Name="Estate status"/>
                            <TextBlock Text="Once stages are recorded on the Checklist tab, the status follows the checklist."
                                       FontFamily="{StaticResource SansFont}" FontSize="11" Foreground="#9CA0A8"
                                       TextWrapping="Wrap" Margin="0,0,0,14"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" BorderBrush="#E4E2DD" BorderThickness="1" CornerRadius="4" Padding="20,18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PARTICULARS OF THE DECEASED" Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="Full Names" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DeceasedFullName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="13" Margin="0,0,0,14"/>

                        <TextBlock Text="Identity Number" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DeceasedIdNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,0,14"
                                 ToolTip="13-digit SA ID number, or a passport number for foreign nationals"/>
                        <TextBlock Text="{Binding DeceasedIdHint}"
                                   Style="{StaticResource InputHintStyle}" Margin="0,-10,0,14"
                                   Visibility="{Binding DeceasedIdHint, Converter={StaticResource StringToVisConverter}}"/>

                        <TextBlock Text="Marital Status" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DeceasedMaritalStatus, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,14"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusMessage}" Foreground="#8B3A3A" FontFamily="{StaticResource SansFont}"
                           FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Background="#6E2A2A" Foreground="White" BorderThickness="0"
                            Padding="16,9" FontFamily="{StaticResource SansFont}" FontSize="13" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Background="Transparent" Foreground="#6B6E76" BorderThickness="1" BorderBrush="#E4E2DD"
                            Padding="16,9" FontFamily="{StaticResource SansFont}" FontSize="13" Cursor="Hand"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>