<UserControl x:Class="EstateFlow.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F4F1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#E4E2DD" BorderThickness="0,0,0,1" Padding="24,12">
            <StackPanel>
                <TextBlock Text="Monthly Report Settings" FontFamily="{StaticResource SerifFont}" FontSize="17" Foreground="#16181C"/>
                <TextBlock Text="{Binding StatusMessage}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#6B6E76" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Background="#F0EEE9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="FILE NO." Style="{StaticResource MonoLabelStyle}" FontSize="9" Foreground="#9CA0A8" Margin="24,8,0,8"/>
            <TextBlock Grid.Column="1" Text="ESTATE" Style="{StaticResource MonoLabelStyle}" FontSize="9" Foreground="#9CA0A8" Margin="0,8,0,8"/>
            <TextBlock Grid.Column="2" Text="LAST SENT" Style="{StaticResource MonoLabelStyle}" FontSize="9" Foreground="#9CA0A8" Margin="0,8,0,8"/>
            <TextBlock Grid.Column="3" Text="REPORT" Style="{StaticResource MonoLabelStyle}" FontSize="9" Foreground="#9CA0A8" Margin="0,8,24,8"/>
        </Grid>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Settings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E4E2DD" BorderThickness="0,0,0,1" Padding="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding FileNumber}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#16181C" Margin="24,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding DeceasedFullName}" FontFamily="{StaticResource SerifFont}" FontSize="13" Foreground="#16181C"/>
                                <TextBlock Grid.Column="2" Text="{Binding LastSentDate, StringFormat='dd MMM yyyy'}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#9CA0A8"/>
                                <Button Grid.Column="3" Content="{Binding IsPaused, Converter={StaticResource PauseToLabelConverter}}"
                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        FontFamily="{StaticResource MonoFont}" FontSize="10"
                                        Foreground="#6E2A2A" HorizontalAlignment="Left" Margin="0,0,24,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>