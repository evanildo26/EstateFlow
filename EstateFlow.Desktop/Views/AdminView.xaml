<UserControl x:Class="EstateFlow.Desktop.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="TableStyle" TargetType="ListView">
            <Setter Property="BorderBrush" Value="#E4E2DD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F4F1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border BorderBrush="#E4E2DD" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Firm Administration" FontFamily="{StaticResource SerifFont}" FontSize="17" Foreground="#16181C"/>
                    <TextBlock Text="Staff accounts · estate assignment · audit log · letter wording · record retention"
                               FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#6B6E76" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource OutlineButtonStyle}" FontSize="12"
                        Padding="12,7" VerticalAlignment="Center" Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <!-- Messages; issued passwords are shown once, selectable for copying -->
        <StackPanel Grid.Row="1">
            <Border Background="#EFEAE4" Padding="24,8"
                    Visibility="{Binding Message, Converter={StaticResource StringToVisConverter}}">
                <TextBlock Text="{Binding Message}" FontFamily="{StaticResource SansFont}" FontSize="12" Foreground="#16181C"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Border>
            <Border Background="#FBF6E9" BorderBrush="#E6D7AE" BorderThickness="0,0,0,1" Padding="24,8"
                    Visibility="{Binding IssuedPassword, Converter={StaticResource StringToVisConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Temporary password:" FontFamily="{StaticResource SansFont}" FontSize="12"
                               Foreground="#6B6E76" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding IssuedPassword, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontFamily="{StaticResource MonoFont}" FontSize="14" VerticalAlignment="Center"
                             AutomationProperties.Name="Temporary password"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,4,0,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="10,8"/>
                </Style>
            </TabControl.Resources>

            <!-- ======================= STAFF ======================= -->
            <TabItem Header="Staff">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <ListView ItemsSource="{Binding Staff}" Style="{StaticResource TableStyle}" Margin="0,0,16,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="160" DisplayMemberBinding="{Binding FullName}"/>
                                <GridViewColumn Header="Email" Width="190" DisplayMemberBinding="{Binding Email}"/>
                                <GridViewColumn Header="Role" Width="120" DisplayMemberBinding="{Binding Role}"/>
                                <GridViewColumn Header="Estates" Width="60" DisplayMemberBinding="{Binding AssignedEstateCount}"/>
                                <GridViewColumn Header="2FA" Width="45" DisplayMemberBinding="{Binding TwoFactorEnabled}"/>
                                <GridViewColumn Header="State" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="State" Text="Active" Foreground="#3F5B45"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsLockedOut}" Value="True">
                                                    <Setter TargetName="State" Property="Text" Value="Locked out"/>
                                                    <Setter TargetName="State" Property="Foreground" Value="#9C7A3C"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDeactivated}" Value="True">
                                                    <Setter TargetName="State" Property="Text" Value="Deactivated"/>
                                                    <Setter TargetName="State" Property="Foreground" Value="#8B3A3A"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Actions" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <WrapPanel>
                                                <Button Content="New password" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,4,2" Padding="6,3"
                                                        Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"/>
                                                <Button Content="Unlock" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,4,2" Padding="6,3"
                                                        Visibility="{Binding IsLockedOut, Converter={StaticResource BoolToVisConverter}}"
                                                        Command="{Binding DataContext.UnlockCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"/>
                                                <Button Content="Reset 2FA" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,4,2" Padding="6,3"
                                                        Visibility="{Binding TwoFactorEnabled, Converter={StaticResource BoolToVisConverter}}"
                                                        Command="{Binding DataContext.ResetTwoFactorCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"/>
                                                <Button Content="Deactivate" Style="{StaticResource RemoveLinkButtonStyle}" Margin="0,0,4,2" Padding="6,3"
                                                        Visibility="{Binding IsDeactivated, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}"
                                                        Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"/>
                                                <Button Content="Reactivate" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,4,2" Padding="6,3"
                                                        Visibility="{Binding IsDeactivated, Converter={StaticResource BoolToVisConverter}}"
                                                        Command="{Binding DataContext.ReactivateCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"/>
                                            </WrapPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Column="1" Style="{StaticResource SectionCardBorderStyle}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="ADD STAFF MEMBER" Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Full name" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding NewStaffName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource QuickAddTextBox}"
                                     AutomationProperties.Name="Full name"/>

                            <TextBlock Text="Work email" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding NewStaffEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource QuickAddTextBox}"
                                     AutomationProperties.Name="Work email"/>

                            <TextBlock Text="Role" Style="{StaticResource FormLabel}"/>
                            <ComboBox ItemsSource="{Binding StaffRoles}" SelectedItem="{Binding NewStaffRole}"
                                      Padding="6,4" Margin="0,0,0,10" AutomationProperties.Name="Role"/>

                            <TextBlock Text="Temporary password" Style="{StaticResource FormLabel}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewStaffPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource QuickAddTextBox}"
                                         FontFamily="{StaticResource MonoFont}" Margin="0" AutomationProperties.Name="Temporary password"/>
                                <Button Grid.Column="1" Content="New" Style="{StaticResource OutlineButtonStyle}" Margin="6,0,0,0"
                                        Command="{Binding GeneratePasswordCommand}" ToolTip="Generate another password"/>
                            </Grid>

                            <Button Content="Create account" Style="{StaticResource AccentButtonStyle}" Command="{Binding CreateStaffCommand}"/>

                            <TextBlock Text="Give the password to the person directly. They should set up two-factor authentication (Security &amp; 2FA) after their first sign-in."
                                       FontFamily="{StaticResource SansFont}" FontSize="11" Foreground="#9CA0A8" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================= ESTATES ======================= -->
            <TabItem Header="Estates">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox Text="{Binding EstateSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             Style="{StaticResource QuickAddTextBox}" Margin="0,0,16,10"
                             ToolTip="Filter by file number, deceased or controller"
                             AutomationProperties.Name="Filter estates"/>

                    <ListView Grid.Row="1" ItemsSource="{Binding Estates}" SelectedItem="{Binding SelectedEstate}"
                              Style="{StaticResource TableStyle}" Margin="0,0,16,0" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="File no." Width="100" DisplayMemberBinding="{Binding FileNumber}"/>
                                <GridViewColumn Header="Deceased" Width="200" DisplayMemberBinding="{Binding DeceasedFullName}"/>
                                <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding EstateStatus}"/>
                                <GridViewColumn Header="Controller" Width="170" DisplayMemberBinding="{Binding ControllerName}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Column="1" Grid.RowSpan="2">
                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="ASSIGN SELECTED ESTATE" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding SelectedEstate.FileNumber, FallbackValue='Select an estate in the list', TargetNullValue='Select an estate in the list'}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Text="To" Style="{StaticResource FormLabel}"/>
                                <ComboBox ItemsSource="{Binding AssignableStaff}" SelectedItem="{Binding AssignTo}" DisplayMemberPath="FullName"
                                          Padding="6,4" Margin="0,0,0,12" AutomationProperties.Name="Assign to"/>
                                <Button Content="Assign" Style="{StaticResource AccentButtonStyle}" Command="{Binding AssignSelectedEstateCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="MOVE ALL ESTATES" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="When someone leaves or goes on extended leave."
                                           FontFamily="{StaticResource SansFont}" FontSize="11" Foreground="#9CA0A8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="From" Style="{StaticResource FormLabel}"/>
                                <ComboBox ItemsSource="{Binding Staff}" SelectedItem="{Binding MoveFrom}" DisplayMemberPath="FullName"
                                          Padding="6,4" Margin="0,0,0,8" AutomationProperties.Name="Move from"/>
                                <TextBlock Text="To" Style="{StaticResource FormLabel}"/>
                                <ComboBox ItemsSource="{Binding AssignableStaff}" SelectedItem="{Binding MoveTo}" DisplayMemberPath="FullName"
                                          Padding="6,4" Margin="0,0,0,12" AutomationProperties.Name="Move to"/>
                                <Button Content="Move all" Style="{StaticResource AccentButtonStyle}" Command="{Binding MoveAllEstatesCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ======================= AUDIT LOG ======================= -->
            <TabItem Header="Audit log">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Estate" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Estates}" SelectedItem="{Binding AuditEstate}" DisplayMemberPath="FileNumber"
                                  Width="160" Padding="6,4" Margin="0,0,14,0" AutomationProperties.Name="Estate"/>
                        <TextBlock Text="User" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding AuditUser, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="6,4" Margin="0,0,14,0"
                                 AutomationProperties.Name="User"/>
                        <Button Content="Show" Style="{StaticResource AccentButtonStyle}" Command="{Binding LoadAuditCommand}"/>
                        <TextBlock Text="Who viewed or changed which estate, most recent first (last 300)."
                                   VerticalAlignment="Center" Margin="14,0,0,0" FontFamily="{StaticResource SansFont}" FontSize="11" Foreground="#9CA0A8"/>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{Binding AuditEntries}" Style="{StaticResource TableStyle}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="When (UTC)" Width="140" DisplayMemberBinding="{Binding TimestampUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"/>
                                <GridViewColumn Header="User" Width="170" DisplayMemberBinding="{Binding UserName}"/>
                                <GridViewColumn Header="Action" Width="80" DisplayMemberBinding="{Binding Action}"/>
                                <GridViewColumn Header="Estate" Width="100" DisplayMemberBinding="{Binding FileNumber}"/>
                                <GridViewColumn Header="Result" Width="60" DisplayMemberBinding="{Binding StatusCode}"/>
                                <GridViewColumn Header="Request" Width="360" DisplayMemberBinding="{Binding Target}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ======================= LETTER WORDING ======================= -->
            <TabItem Header="Letter wording">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" Margin="0,0,16,0"
                             BorderBrush="#E4E2DD" AutomationProperties.Name="Letters">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource SansFont}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="Customised" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="#6E2A2A"
                                               Visibility="{Binding IsCustomised, Converter={StaticResource BoolToVisConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Subject line (shown as RE: …)" Style="{StaticResource FormLabel}"/>
                        <TextBox Grid.Row="1" Text="{Binding TemplateSubject, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource QuickAddTextBox}"
                                 AutomationProperties.Name="Subject line"/>
                        <TextBlock Grid.Row="2" Text="Body (leave a blank line between paragraphs). The letterhead, date, references, address and signature are added automatically."
                                   Style="{StaticResource FormLabel}" TextWrapping="Wrap"/>
                        <TextBox Grid.Row="3" Text="{Binding TemplateBody, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource SansFont}" FontSize="12" Padding="8"
                                 AutomationProperties.Name="Letter body"/>
                        <TextBlock Grid.Row="4" Text="{Binding TemplatePlaceholders, StringFormat='Available fields:  {0}'}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="#6B6E76" TextWrapping="Wrap" Margin="0,8,0,10"/>
                        <StackPanel Grid.Row="5" Orientation="Horizontal">
                            <Button Content="Save wording" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveTemplateCommand}" Margin="0,0,10,0"/>
                            <Button Content="Restore standard wording" Style="{StaticResource OutlineButtonStyle}" Command="{Binding ResetTemplateCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ======================= RETENTION ======================= -->
            <TabItem Header="Retention">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontFamily="{StaticResource SansFont}" FontSize="12" Foreground="#6B6E76"
                               Text="Estates finalised longer ago than the firm's retention period (POPIA: personal information may not be kept longer than necessary). Nothing is deleted automatically. Archive anything the firm must keep before purging."/>

                    <ListView Grid.Row="1" ItemsSource="{Binding RetentionCandidates}" Style="{StaticResource TableStyle}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="File no." Width="100" DisplayMemberBinding="{Binding FileNumber}"/>
                                <GridViewColumn Header="Deceased" Width="220" DisplayMemberBinding="{Binding DeceasedFullName}"/>
                                <GridViewColumn Header="Finalised" Width="110" DisplayMemberBinding="{Binding FinalisedOn, StringFormat='{}{0:d MMM yyyy}'}"/>
                                <GridViewColumn Header="Controller" Width="170" DisplayMemberBinding="{Binding ControllerName}"/>
                                <GridViewColumn Header="" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Purge permanently" Style="{StaticResource RemoveLinkButtonStyle}"
                                                    Command="{Binding DataContext.PurgeEstateCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
